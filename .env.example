# Copy to .env (git-ignored). Real env vars override this file.
# --- models: offline (default: deterministic, free, no keys) | auto | anthropic -----------------------------------------
TRAGEDY_PROVIDER=offline
# ANTHROPIC_API_KEY=            # with TRAGEDY_PROVIDER=auto the puppets get Claude's voice; scores never depend on it
# ANTHROPIC_WORKSPACE_ID=       # REQUIRED if your key is not scoped to a workspace (sent as `anthropic-workspace-id`, else HTTP 400)
# TRAGEDY_MODEL_FAST=claude-haiku-5-5
# TRAGEDY_MODEL_SMART=claude-sonnet-5-5
TRAGEDY_OFFLINE_TOKEN_DELAY_S=0.012
# --- LangSmith tracing. Needed for LangGraph Studio's Trace tab and the in-game 'View trace' link; also removes Studio's
# --- "LANGSMITH_API_KEY is missing" banner. `make dev TRACE=1` forces it on, `make dev NOTRACE=1` off. -----------------
LANGSMITH_TRACING=false
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=probably-a-tragedy
# --- server ------------------------------------------------------------------------------------------------------------
TRAGEDY_PUBLIC_BASE_URL=http://127.0.0.1:2027
RESUMABLE_STREAM_TTL_SECONDS=7200
# --- OpenAI (opt-in; the puppets' voices only, scores never depend on model text) ------------------------------------------
# TRAGEDY_PROVIDER=openai
# OPENAI_API_KEY=
# TRAGEDY_OPENAI_MODEL_FAST=gpt-5.4-mini      # any chat model your key can use (GET /v1/models)
# TRAGEDY_OPENAI_MODEL_SMART=gpt-5.4-mini     # the greenroom tool-calling agent
